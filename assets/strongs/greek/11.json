{"G1100":{"lemma":"γλῶσσα","xlit":"glōssa","derivation":"of uncertain affinity;","def":"the tongue; by implication, a language (specially, one naturally unacquired)","kjv":"tongue"},"G1101":{"lemma":"γλωσσόκομον","xlit":"glōssókomon","derivation":"from G1100 (γλῶσσα) and the base of G2889 (κόσμος);","def":"properly, a case (to keep mouthpieces of wind-instruments in) i.e. (by extension) a casket or (specially) purse","kjv":"bag"},"G1102":{"lemma":"γναφεύς","xlit":"gnapheús","derivation":"by variation for a derivative from (to tease cloth);","def":"a cloth-dresser","kjv":"fuller"},"G1103":{"lemma":"γνήσιος","xlit":"gnḗsios","derivation":"from the same as G1077 (γενέσια);","def":"legitimate (of birth), i.e. genuine","kjv":"own, sincerity, true"},"G1104":{"lemma":"γνησίως","xlit":"gnēsíōs","derivation":"adverb from G1103 (γνήσιος);","def":"genuinely, i.e. really","kjv":"naturally"},"G1105":{"lemma":"γνόφος","xlit":"gnóphos","derivation":"akin to G3509 (νέφος);","def":"gloom (as of a storm)","kjv":"blackness"},"G1106":{"lemma":"γνώμη","xlit":"gnṓmē","derivation":"from G1097 (γινώσκω);","def":"cognition, i.e. (subjectively) opinion, or (objectively) resolve (counsel, consent, etc.)","kjv":"advice, + agree, judgment, mind, purpose, will"},"G1107":{"lemma":"γνωρίζω","xlit":"gnōrízō","derivation":"from a derivative of G1097 (γινώσκω);","def":"to make known; subjectively, to know","kjv":"certify, declare, make known, give to understand, do to wit, wot"},"G1108":{"lemma":"γνῶσις","xlit":"gnōsis","derivation":"from G1097 (γινώσκω);","def":"knowing (the act), i.e. (by implication) knowledge","kjv":"knowledge, science"},"G1109":{"lemma":"γνώστης","xlit":"gnṓstēs","derivation":"from G1097 (γινώσκω);","def":"a knower","kjv":"expert"},"G1110":{"lemma":"γνωστός","xlit":"gnōstós","derivation":"from G1097 (γινώσκω);","def":"well-known","kjv":"acquaintance, (which may be) known, notable"},"G1111":{"lemma":"γογγύζω","xlit":"gongýzō","derivation":"of uncertain derivation;","def":"to grumble","kjv":"murmur"},"G1112":{"lemma":"γογγυσμός","xlit":"gongysmós","derivation":"from G1111 (γογγύζω);","def":"a grumbling","kjv":"grudging, murmuring"},"G1113":{"lemma":"γογγυστής","xlit":"gongystḗs","derivation":"from G1111 (γογγύζω);","def":"a grumbler","kjv":"murmurer"},"G1114":{"lemma":"γόης","xlit":"góēs","derivation":"from (to wail);","def":"properly, a wizard (as muttering spells), i.e. (by implication) an imposter","kjv":"seducer"},"G1115":{"lemma":"Γολγοθᾶ","xlit":"Golgothâ","derivation":"of Chaldee origin (compare H01538);","def":"the skull; Golgotha, a knoll near Jerusalem","kjv":"Golgotha"},"G1116":{"lemma":"Γόμοῤῥα","xlit":"Gómorrha","derivation":"of Hebrew origin (H06017);","def":"Gomorrha (i.e. Amorah), a place near the Dead Sea","kjv":"Gomorrha"},"G1117":{"lemma":"γόμος","xlit":"gómos","derivation":"from G1073 (γέμω);","def":"a load (as filling), i.e. (specially) a cargo, or (by extension) wares","kjv":"burden, merchandise"},"G1118":{"lemma":"γονεύς","xlit":"goneús","derivation":"from the base of G1096 (γίνομαι);","def":"a parent","kjv":"parent"},"G1119":{"lemma":"γόνυ","xlit":"góny","derivation":"of uncertain affinity;","def":"the \"knee\"","kjv":"knee(X -l)"},"G1120":{"lemma":"γονυπετέω","xlit":"gonypetéō","derivation":"from a compound of G1119 (γόνυ) and the alternate of G4098 (πίπτω);","def":"to fall on the knee","kjv":"bow the knee, kneel down"},"G1121":{"lemma":"γράμμα","xlit":"grámma","derivation":"from G1125 (γράφω);","def":"a writing, i.e. a letter, note, epistle, book, etc.; plural learning","kjv":"bill, learning, letter, scripture, writing, written"},"G1122":{"lemma":"γραμματεύς","xlit":"grammateús","derivation":"from G1121 (γράμμα). a writer, i.e. (professionally) scribe or secretary","kjv":"scribe, town-clerk"},"G1123":{"lemma":"γραπτός","xlit":"graptós","derivation":"from G1125 (γράφω);","def":"inscribed (figuratively)","kjv":"written"},"G1124":{"lemma":"γραφή","xlit":"graphḗ","derivation":"from G1125 (γράφω);","def":"a document, i.e. holy Writ (or its contents or a statement in it)","kjv":"scripture"},"G1125":{"lemma":"γράφω","xlit":"gráphō","derivation":"a primary verb;","def":"to \"grave\", especially to write; figuratively, to describe","kjv":"describe, write(-ing, -ten)"},"G1126":{"lemma":"γραώδης","xlit":"graṓdēs","derivation":"from (an old woman) and G1491 (εἶδος);","def":"crone-like, i.e. silly","kjv":"old wives'"},"G1127":{"lemma":"γρηγορεύω","xlit":"grēgoreúō","derivation":"from G1453 (ἐγείρω);","def":"to keep awake, i.e. watch (literally or figuratively)","kjv":"be vigilant, wake, (be) watch(-ful)"},"G1128":{"lemma":"γυμνάζω","xlit":"gymnázō","derivation":"from G1131 (γυμνός);","def":"to practise naked (in the games), i.e. train (figuratively)","kjv":"exercise"},"G1129":{"lemma":"γυμνασία","xlit":"gymnasía","derivation":"from G1128 (γυμνάζω);","def":"training, i.e. (figuratively) asceticism","kjv":"exercise"},"G1130":{"lemma":"γυμνητεύω","xlit":"gymnēteúō","derivation":"from a derivative of G1131 (γυμνός);","def":"to strip, i.e. (reflexively) go poorly clad","kjv":"be naked"},"G1131":{"lemma":"γυμνός","xlit":"gymnós","derivation":"of uncertain affinity;","def":"nude (absolute or relative, literal or figurative)","kjv":"naked"},"G1132":{"lemma":"γυμνότης","xlit":"gymnótēs","derivation":"from G1131 (γυμνός);","def":"nudity (absolute or comparative)","kjv":"nakedness"},"G1133":{"lemma":"γυναικάριον","xlit":"gynaikárion","derivation":"a diminutive from G1135 (γυνή);","def":"a little (i.e. foolish) woman","kjv":"silly woman"},"G1134":{"lemma":"γυναικεῖος","xlit":"gynaikeîos","derivation":"from G1135 (γυνή);","def":"feminine","kjv":"wife"},"G1135":{"lemma":"γυνή","xlit":"gynḗ","derivation":"probably from the base of G1096 (γίνομαι);","def":"a woman; specially, a wife","kjv":"wife, woman"},"G1136":{"lemma":"Γώγ","xlit":"Gṓg","derivation":"of Hebrew origin (H01463);","def":"Gog, a symbolic name for some future Antichrist","kjv":"Gog"},"G1137":{"lemma":"γωνία","xlit":"gōnía","derivation":"probably akin to G1119 (γόνυ);","def":"an angle","kjv":"corner, quarter"},"G1138":{"lemma":"Δαβίδ","xlit":"Dabíd","derivation":"of Hebrew origin (H01732);","def":"Dabid (i.e. David), the Israelite king","kjv":"David"},"G1139":{"lemma":"δαιμονίζομαι","xlit":"daimonízomai","derivation":"middle voice from G1142 (δαίμων);","def":"to be exercised by a dæmon","kjv":"have a (be vexed with, be possessed with) devil(-s)"},"G1140":{"lemma":"δαιμόνιον","xlit":"daimónion","derivation":"neuter of a derivative of G1142 (δαίμων);","def":"a dæmonic being; by extension a deity","kjv":"devil, god"},"G1141":{"lemma":"δαιμονιώδης","xlit":"daimoniṓdēs","derivation":"from G1140 (δαιμόνιον) and G1142 (δαίμων);","def":"dæmon-like","kjv":"devilish"},"G1142":{"lemma":"δαίμων","xlit":"daímōn","derivation":"from (to distribute fortunes);","def":"a dæmon or supernatural spirit (of a bad nature)","kjv":"devil"},"G1143":{"lemma":"δάκνω","xlit":"dáknō","derivation":"a prolonged form of a primary root;","def":"to bite, i.e. (figuratively) thwart","kjv":"bite"},"G1144":{"lemma":"δάκρυ","xlit":"dákry","derivation":"of uncertain affinity;","def":"a tear","kjv":"tear"},"G1145":{"lemma":"δακρύω","xlit":"dakrýō","derivation":"from G1144 (δάκρυ);","def":"to shed tears","kjv":"weep"},"G1146":{"lemma":"δακτύλιος","xlit":"daktýlios","derivation":"from G1147 (δάκτυλος);","def":"a finger-ring","kjv":"ring"},"G1147":{"lemma":"δάκτυλος","xlit":"dáktylos","derivation":"probably from G1176 (δέκα);","def":"a finger","kjv":"finger"},"G1148":{"lemma":"Δαλμανουθά","xlit":"Dalmanouthá","derivation":"probably of Chaldee origin;","def":"Dalmanutha, a place in Palestine","kjv":"Dalmanutha"},"G1149":{"lemma":"Δαλματία","xlit":"Dalmatía","derivation":"probably of foreign derivation;","def":"Dalmatia, a region of Europe","kjv":"Dalmatia"},"G1150":{"lemma":"δαμάζω","xlit":"damázō","derivation":"a variation of an obsolete primary of the same meaning;","def":"to tame","kjv":"tame"},"G1151":{"lemma":"δάμαλις","xlit":"dámalis","derivation":"probably from the base of G1150 (δαμάζω);","def":"a heifer (as tame)","kjv":"heifer"},"G1152":{"lemma":"Δάμαρις","xlit":"Dámaris","derivation":"probably from the base of G1150 (δαμάζω);","def":"perhaps gentle; Damaris, an Athenian woman","kjv":"Damaris"},"G1153":{"lemma":"Δαμασκηνός","xlit":"Damaskēnós","derivation":"from G1154 (Δαμασκός);","def":"a Damascene or inhabitant of Damascus","kjv":"Damascene"},"G1154":{"lemma":"Δαμασκός","xlit":"Damaskós","derivation":"of Hebrew origin (H01834);","def":"Damascus, a city of Syria","kjv":"Damascus"},"G1155":{"lemma":"δανείζω","xlit":"daneízō","derivation":"from G1156 (δάνειον);","def":"to loan on interest; reflexively, to borrow","kjv":"borrow, lend"},"G1156":{"lemma":"δάνειον","xlit":"dáneion","derivation":"from (a gift);","def":"probably akin to the base of G1325 (δίδωμι); a loan","kjv":"debt"},"G1157":{"lemma":"δανειστής","xlit":"daneistḗs","derivation":"from G1155 (δανείζω);","def":"a lender","kjv":"creditor"},"G1158":{"lemma":"Δανιήλ","xlit":"Daniḗl","derivation":"of Hebrew origin (H01840);","def":"Daniel, an Israelite","kjv":"Daniel"},"G1159":{"lemma":"δαπανάω","xlit":"dapanáō","derivation":"from G1160 (δαπάνη);","def":"to expend, i.e. (in a good sense) to incur cost, or (in a bad one) to waste","kjv":"be at charges, consume, spend"},"G1160":{"lemma":"δαπάνη","xlit":"dapánē","derivation":"from (to devour);","def":"expense (as consuming)","kjv":"cost"},"G1161":{"lemma":"δέ","xlit":"dé","derivation":"a primary particle (adversative or continuative);","def":"but, and, etc.","kjv":"also, and, but, moreover, now (often unexpressed in English)"},"G1162":{"lemma":"δέησις","xlit":"déēsis","derivation":"from G1189 (δέομαι);","def":"a petition","kjv":"prayer, request, supplication"},"G1163":{"lemma":"δεῖ","xlit":"deî","derivation":"3rd person singular active present of G1210 (δέω);","def":"also deon deh-on'; neuter active participle of the same; both used impersonally; it is (was, etc.) necessary (as binding)","kjv":"b