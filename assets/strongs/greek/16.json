{"G1600":{"lemma":"ἐκπετάννυμι","xlit":"ekpetánnymi","derivation":"from G1537 (ἐκ) and a form of G4072 (πέτομαι);","def":"to fly out, i.e. (by analogy) to extend","kjv":"stretch forth"},"G1601":{"lemma":"ἐκπίπτω","xlit":"ekpíptō","derivation":"from G1537 (ἐκ) and G4098 (πίπτω);","def":"to drop away; specially, be driven out of one's course; figuratively, to lose, become inefficient","kjv":"be cast, fail, fall (away, off), take none effect"},"G1602":{"lemma":"ἐκπλέω","xlit":"ekpléō","derivation":"from G1537 (ἐκ) and G4126 (πλέω);","def":"to depart by ship","kjv":"sail (away, thence)"},"G1603":{"lemma":"ἐκπληρόω","xlit":"ekplēróō","derivation":"from G1537 (ἐκ) and G4137 (πληρόω);","def":"to accomplish entirely","kjv":"fulfill"},"G1604":{"lemma":"ἐκπλήρωσις","xlit":"ekplḗrōsis","derivation":"from G1603 (ἐκπληρόω);","def":"completion","kjv":"accomplishment"},"G1605":{"lemma":"ἐκπλήσσω","xlit":"ekplḗssō","derivation":"from G1537 (ἐκ) and G4141 (πλήσσω);","def":"to strike with astonishment","kjv":"amaze, astonish"},"G1606":{"lemma":"ἐκπνέω","xlit":"ekpnéō","derivation":"from G1537 (ἐκ) and G4154 (πνέω);","def":"to expire","kjv":"give up the ghost"},"G1607":{"lemma":"ἐκπορεύομαι","xlit":"ekporeúomai","derivation":"from G1537 (ἐκ) and G4198 (πορεύομαι);","def":"to depart, be discharged, proceed, project","kjv":"come (forth, out of), depart, go (forth, out), issue, proceed (out of)"},"G1608":{"lemma":"ἐκπορνεύω","xlit":"ekporneúō","derivation":"from G1537 (ἐκ) and G4203 (πορνεύω);","def":"to be utterly unchaste","kjv":"give self over to fornication"},"G1609":{"lemma":"ἐκπτύω","xlit":"ekptýō","derivation":"from G1537 (ἐκ) and G4429 (πτύω);","def":"to spit out, i.e. (figuratively) spurn","kjv":"reject"},"G1610":{"lemma":"ἐκριζόω","xlit":"ekrizóō","derivation":"from G1537 (ἐκ) and G4492 (ῥιζόω);","def":"to uproot","kjv":"pluck up by the root, root up"},"G1611":{"lemma":"ἔκστασις","xlit":"ékstasis","derivation":"from G1839 (ἐξίστημι);","def":"a displacement of the mind, i.e. bewilderment, \"ecstasy\"","kjv":"+ be amazed, amazement, astonishment, trance"},"G1612":{"lemma":"ἐκστρέφω","xlit":"ekstréphō","derivation":"from G1537 (ἐκ) and G4762 (στρέφω);","def":"to pervert (figuratively)","kjv":"subvert"},"G1613":{"lemma":"ἐκταράσσω","xlit":"ektarássō","derivation":"from G1537 (ἐκ) and G5015 (ταράσσω);","def":"to disturb wholly","kjv":"exceedingly trouble"},"G1614":{"lemma":"ἐκτείνω","xlit":"ekteínō","derivation":"from G1537 (ἐκ) and teino (to stretch);","def":"to extend","kjv":"cast, put forth, stretch forth (out)"},"G1615":{"lemma":"ἐκτελέω","xlit":"ekteléō","derivation":"from G1537 (ἐκ) and G5055 (τελέω);","def":"to complete fully","kjv":"finish"},"G1616":{"lemma":"ἐκτένεια","xlit":"ekténeia","derivation":"from G1618 (ἐκτενής);","def":"intentness","kjv":"X instantly"},"G1617":{"lemma":"ἐκτενέστερον","xlit":"ektenésteron","derivation":"neuter of the comparative of G1618 (ἐκτενής);","def":"more intently","kjv":"more earnestly"},"G1618":{"lemma":"ἐκτενής","xlit":"ektenḗs","derivation":"from G1614 (ἐκτείνω);","def":"intent","kjv":"without ceasing, fervent"},"G1619":{"lemma":"ἐκτενῶς","xlit":"ektenōs","derivation":"adverb from G1618 (ἐκτενής);","def":"intently","kjv":"fervently"},"G1620":{"lemma":"ἐκτίθημι","xlit":"ektíthēmi","derivation":"from G1537 (ἐκ) and G5087 (τίθημι);","def":"to expose; figuratively, to declare","kjv":"cast out, expound"},"G1621":{"lemma":"ἐκτινάσσω","xlit":"ektinássō","derivation":"from G1537 (ἐκ) and tinasso (to swing);","def":"to shake violently","kjv":"shake (off)"},"G1622":{"lemma":"ἐκτός","xlit":"ektós","derivation":"from G1537 (ἐκ);","def":"the exterior; figuratively (as a preposition) aside from, besides","kjv":"but, except(-ed), other than, out of, outside, unless, without"},"G1623":{"lemma":"ἕκτος","xlit":"héktos","derivation":"ordinal from G1803 (ἕξ);","def":"sixth","kjv":"sixth"},"G1624":{"lemma":"ἐκτρέπω","xlit":"ektrépō","derivation":"from G1537 (ἐκ) and the base of G5157 (τροπή);","def":"to deflect, i.e. turn away (literally or figuratively)","kjv":"avoid, turn (aside, out of the way)"},"G1625":{"lemma":"ἐκτρέφω","xlit":"ektréphō","derivation":"from G1537 (ἐκ) and G5142 (τρέφω);","def":"to rear up to maturity, i.e. (genitive case) to cherish or train","kjv":"bring up, nourish"},"G1626":{"lemma":"ἔκτρωμα","xlit":"éktrōma","derivation":"from a comparative of G1537 (ἐκ) and (to wound);","def":"a miscarriage (abortion), i.e. (by analogy) untimely birth","kjv":"born out of due time"},"G1627":{"lemma":"ἐκφέρω","xlit":"ekphérō","derivation":"from G1537 (ἐκ) and G5342 (φέρω);","def":"to bear out (literally or figuratively)","kjv":"bear, bring forth, carry forth (out)"},"G1628":{"lemma":"ἐκφεύγω","xlit":"ekpheúgō","derivation":"from G1537 (ἐκ) and G5343 (φεύγω);","def":"to flee out","kjv":"escape, flee"},"G1629":{"lemma":"ἐκφοβέω","xlit":"ekphobéō","derivation":"from G1537 (ἐκ) and G5399 (φοβέω);","def":"to frighten utterly","kjv":"terrify"},"G1630":{"lemma":"ἔκφοβος","xlit":"ékphobos","derivation":"from G1537 (ἐκ) and G5401 (φόβος);","def":"frightened out of one's wits","kjv":"sore afraid, exceedingly fear"},"G1631":{"lemma":"ἐκφύω","xlit":"ekphýō","derivation":"from G1537 (ἐκ) and G5453 (φύω);","def":"to sprout up","kjv":"put forth"},"G1632":{"lemma":"ἐκχέω","xlit":"ekchéō","derivation":"from G1537 (ἐκ) and (to pour);","def":"to pour forth; figuratively, to bestow","kjv":"gush (pour) out, run greedily (out), shed (abroad, forth), spill"},"G1633":{"lemma":"ἐκχωρέω","xlit":"ekchōréō","derivation":"from G1537 (ἐκ) and G5562 (χωρέω);","def":"to depart","kjv":"depart out"},"G1634":{"lemma":"ἐκψύχω","xlit":"ekpsýchō","derivation":"from G1537 (ἐκ) and G5594 (ψύχω);","def":"to expire","kjv":"give (yield) up the ghost"},"G1635":{"lemma":"ἑκών","xlit":"hekṓn","derivation":"of uncertain affinity;","def":"voluntary","kjv":"willingly"},"G1636":{"lemma":"ἐλαία","xlit":"elaía","derivation":"feminine of a presumed derivative from an obsolete primary;","def":"an olive (the tree or the fruit)"