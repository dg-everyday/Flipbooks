{"G3400":{"lemma":"μίλιον","xlit":"mílion","derivation":"of Latin origin;","def":"a thousand paces, i.e. a \"mile\"","kjv":"mile"},"G3401":{"lemma":"μιμέομαι","xlit":"miméomai","derivation":"middle voice from (a \"mimic\");","def":"to imitate","kjv":"follow"},"G3402":{"lemma":"μιμητής","xlit":"mimētḗs","derivation":"from G3401 (μιμέομαι);","def":"an imitator","kjv":"follower"},"G3403":{"lemma":"μιμνήσκω","xlit":"mimnḗskō","derivation":"a prolonged form of G3415 (μνάομαι) (from which some of the tenses are borrowed);","def":"to remind, i.e. (middle voice) to recall to mind","kjv":"be mindful, remember"},"G3404":{"lemma":"μισέω","xlit":"miséō","derivation":"from a primary (hatred);","def":"to detest (especially to persecute); by extension, to love less","kjv":"hate(-ful)"},"G3405":{"lemma":"μισθαποδοσία","xlit":"misthapodosía","derivation":"from G3406 (μισθαποδότης);","def":"requital (good or bad)","kjv":"recompence of reward"},"G3406":{"lemma":"μισθαποδότης","xlit":"misthapodótēs","derivation":"from G3409 (μισθόω) and G591 (ἀποδίδωμι);","def":"a renumerator","kjv":"rewarder"},"G3407":{"lemma":"μίσθιος","xlit":"místhios","derivation":"from G3408 (μισθός);","def":"a wage-earner","kjv":"hired servant"},"G3408":{"lemma":"μισθός","xlit":"misthós","derivation":"apparently a primary word;","def":"pay for service (literally or figuratively), good or bad","kjv":"hire, reward, wages"},"G3409":{"lemma":"μισθόω","xlit":"misthóō","derivation":"from G3408 (μισθός);","def":"to let out for wages, i.e. (middle voice) to hire","kjv":"hire"},"G3410":{"lemma":"μίσθωμα","xlit":"místhōma","derivation":"from G3409 (μισθόω);","def":"a rented building","kjv":"hired house"},"G3411":{"lemma":"μισθωτός","xlit":"misthōtós","derivation":"from G3409 (μισθόω);","def":"a wage-worker (good or bad)","kjv":"hired servant, hireling"},"G3412":{"lemma":"Μιτυλήνη","xlit":"Mitylḗnē","derivation":"for (abounding in shellfish);","def":"Mitylene (or Mytilene), a town on the island of Lesbos","kjv":"Mitylene"},